# Copy to `.dev.vars` for local dev (gitignored). Secrets only — regular
# config lives in wrangler.toml.

# The Movie Database API key (get one free at themoviedb.org).
TMDB_API_KEY=""

# HMAC secret for profile session tokens. Any long random string works
# locally; production must use `wrangler secret put SESSION_SECRET`.
SESSION_SECRET="dev-secret-change-me"
