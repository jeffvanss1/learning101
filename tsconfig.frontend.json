{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // The new no-build frontend modules (JSDoc-typed). Legacy scripts are
  // syntax-checked via `node --check` in the `check` npm script.
  "include": ["dist/js/types.js", "dist/js/social.js"]
}
