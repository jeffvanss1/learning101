# Static-asset cache policy (Pages-style _headers, honored by Workers
# Static Assets). HTML must always revalidate — a stale index.html pairing
# old markup with new scripts caused several "still broken" reports.
/index.html
  Cache-Control: no-store

/sw.js
  Cache-Control: no-store

# Versioned assets (?v=N in the HTML). Kept at 1h, NOT hard-cached:
# a forgotten ?v bump used to freeze users on a stale stylesheet for a
# full day (people-search rendered as an unstyled vertical stack).
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600
